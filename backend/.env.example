# Variables de entorno de la API (cópialas en el panel de tu hosting)
# Origen(es) de tu web en Netlify, sin barra final, separados por comas:
ALLOWED_ORIGINS=https://opticore-demo.netlify.app

# Opción 1 — una sola URL de conexión (Aiven, TiDB Cloud, Railway…):
MYSQL_URL=mysql://USUARIO:CONTRASENA@HOST:3306/opticore
# Si el proveedor exige TLS (Aiven, TiDB Cloud):
DB_SSL=true

# Opción 2 — variables sueltas (si no usas MYSQL_URL):
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=opticore
